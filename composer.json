{
  "autoload": {
    "psr-4": {
      "rBibliaWeb\\": "src/core/"
    }
  },
  "config": {
    "vendor-dir": "src/vendor/",
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "require": {
    "php": ">=8.3.0",
    "ext-zlib": "*",
    "ext-simplexml": "*",
    "symfony/console": "^7.4.8",
    "doctrine/dbal": "^4.4.3",
    "nikic/fast-route": "^1.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.1",
    "phpstan/phpstan": "^2.1.47",
    "rector/rector": "^2.4.1",
    "phpunit/phpunit": "^12.5.19"
  }
}
