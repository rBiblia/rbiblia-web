{
  "autoload": {
    "psr-4": {
      "rBibliaWeb\\": "src/core/"
    }
  },
  "config": {
    "vendor-dir": "src/vendor/",
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "require": {
    "php": ">=8.5.0",
    "ext-zlib": "*",
    "ext-simplexml": "*",
    "symfony/console": "^8.1",
    "doctrine/dbal": "^4.5",
    "nikic/fast-route": "^1.3",
    "symfony/mailer": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "rector/rector": "^2.8",
    "phpunit/phpunit": "^13.4"
  }
}
